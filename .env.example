# Copy to .env.local and fill in.

# Public site URL, used for canonical URLs, sitemap, Open Graph and structured data.
# On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL; locally to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://yourdomain.co.ke

# Supabase (Project Settings → API). Without these the app runs in DEMO mode (no server).
# To use the Go backend in ../finfe-backend, set this instead. It takes priority over Supabase.
# Go mode sends readable financial rows to PostgreSQL for server reports alongside the encrypted vault.
NEXT_PUBLIC_FINFE_API_URL=http://localhost:8080

# Legacy Supabase mode (omit when using the Go backend).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Public contact address shown on the site.
NEXT_PUBLIC_SUPPORT_EMAIL=support@yourdomain.co.ke
